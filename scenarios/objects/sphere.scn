<?xml version="1.0"?>
<scenario>
    <looks>
        <look name="black" gray="0.01" roughness="0.3" metalness="0.2" />
        <look name="red" rgb="1.0 0.0 0.0" roughness="0.2" />
    </looks>

    <static name="Hole_GT" type="model">
        <physical>
            <mesh filename="$(find girona500_description)/resources/objects/net/sphere.obj" scale="0.05"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/> 
        </physical>
        <visual>
            <mesh filename="$(find girona500_description)/resources/objects/net/sphere.obj" scale="0.05"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>    
        </visual>
        <material name="Neutral" />
        <look name="red" />
        <world_transform xyz="$(arg xyz)" rpy="$(arg rpy)"/>
    </static>
</scenario>