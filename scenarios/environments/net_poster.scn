<?xml version="1.0"?>
<scenario>
    <environment>
        <ned latitude="39.9944" longitude="-0.0741" />
        <ocean />
        <atmosphere>
            <sun azimuth="-108.0" elevation="50.0" />
        </atmosphere>
    </environment>
    
    <materials>
		<material name="Neutral" density="1000.0" restitution="0.5"/>
    </materials>

    <looks>
        <look name="cirtesu_tank" gray="1.0" roughness="0.2" metalness="0.0" texture="$(find girona500_description)/meshes/cirtesu/tank_tex.png" />
        <look name="net_poster" gray="1.0" roughness="0.8" texture="$(find girona500_description)/meshes/nets/frame_000170.jpg"/> 
    </looks>
    
    <static name="Poster" type="box">
		<dimensions xyz="3.5 7.5 0.05"/>
		<material name="Neutral"/>
		<look name="net_poster" uv_mode="1"/>
		<world_transform rpy="0.0 1.5708 1.578" xyz="4.0 -3.6 2.5"/> <!-- 0.0 0.0 1.578                1.0 0.0 4.8  -6.0 -3.6 0.0 -->
   </static>

    <static name="Tank" type="model">
        <physical>
            <mesh filename="$(find girona500_description)/meshes/cirtesu/tank_phy.obj" scale="1.0" />
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
        </physical>
        <visual>
            <mesh filename="$(find girona500_description)/meshes/cirtesu/tank_vis.obj" scale="1.0" />
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
        </visual>
        <material name="Rock" />
        <look name="cirtesu_tank" />
        <world_transform rpy="0.0 0.0 3.1416" xyz="0.0 0.0 0.0" />
    </static>

</scenario>